                    },
                    "dPOb1": {
                      "content": "Yes. Free and open source, no paywall or account."
                    }
                  }
                },
                {
                  "id": "U5FK6",
                  "type": "ref",
                  "ref": "Q9CyA",
                  "name": "Is Showhow a new app or a fork?",
                  "width": "fill_container",
                  "descendants": {
                    "s0SJYT": {
                      "content": "Is Showhow a new app or a fork?",
                      "fill": "$landing-text"
                    },
                    "FzgiG": {
                      "content": "+"
                    },
                    "dJ8Py": {
                      "enabled": false
                    },
                    "dPOb1": {
                      "content": "It is a fork of OpenScreen, the open-source screen recorder created by Siddharth Vaddem and now continued by the OpenScreen contributors. Showhow keeps OpenScreen’s recorder and editor and adds a library of your recordings and the step-by-step guides. If you only want a recorder, OpenScreen is excellent on its own. Both are MIT licensed."
                    }
                  }
                },
                {
                  "id": "Zhwn9",
                  "type": "ref",
                  "ref": "Q9CyA",
                  "name": "Does it upload my recordings?",
                  "width": "fill_container",
                  "descendants": {
                    "s0SJYT": {
                      "content": "Does it upload my recordings?",
                      "fill": "$landing-text"
                    },
                    "FzgiG": {
                      "content": "+"
                    },
                    "dJ8Py": {
                      "enabled": false
                    },
                    "dPOb1": {
                      "content": "No. Recording happens on your Mac. AI only runs when you connect your own OpenRouter key, and only for the guide step."
                    }
                  }
                },
                {
                  "id": "xvIvG",
                  "type": "ref",
                  "ref": "Q9CyA",
                  "name": "What if the AI step fails?",
                  "width": "fill_container",
                  "descendants": {
                    "s0SJYT": {
                      "content": "What if the AI step fails?",
                      "fill": "$landing-text"
                    },
                    "FzgiG": {
                      "content": "+"
                    },
                    "dJ8Py": {
                      "enabled": false
                    },
                    "dPOb1": {
                      "content": "The recording always saves. A failed guide never loses a take."
                    }
                  }
                },
